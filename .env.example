# Copy to .env or .env.local (both gitignored) and adjust as needed.

# Forces the game to treat the Bloxity SDK (sdk.bloxity.io) and avatar CDN
# (static.bloxity.io) as unavailable, regardless of whether they actually
# load. Useful for local dev when those hosts are blocked, slow, or simply
# not worth waiting on — the scene boots straight onto the game's own
# character and signed-out HUD state instead of racing the real CDN.
# Unset or "false" (default): try the real SDK/CDN as normal.
VITE_DEV_MODE=false


# Starting values for a new session (integers). Unset/invalid = 0.
# Restart the dev server after changing these.
VITE_INITIAL_SKILL=0
VITE_INITIAL_REBIRTHS=0
VITE_INITIAL_WINS=0

# Automatically rebirth as soon as the level cap for the current rebirth is
# reached, instead of waiting for the player to confirm in the rebirth modal.
# "true" enables it; unset or anything else (default) keeps rebirth manual.
# Restart the dev server after changing this.
VITE_AUTO_REBIRTH=false
